{
  "name": "wolfbud-claude-mod",
  "private": true,
  "type": "module",
  "scripts": {
    "window:dev": "vite --config window/vite.config.ts",
    "window:build": "vite build --config window/vite.config.ts",
    "window:typecheck": "tsc -p window",
    "agent:sync": "node scripts/sync-agent.mjs",
    "agent:simulate": "node scripts/simulate-agent.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p window && tsc -p mods/wolfbud",
    "prepare": "husky",
    "install-plugin": "node scripts/install-plugin.mjs",
    "macos:build": "macos/scripts/package-app.sh"
  },
  "devDependencies": {
    "@elevenlabs/client": "1.26.0",
    "@elevenlabs/elevenlabs-js": "2.70.0",
    "@eslint/js": "10.0.1",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "three": "0.186.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  }
}
